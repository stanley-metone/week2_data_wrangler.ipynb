is_fault = (raw_ts['Pressure_PSI'].isin([-50, 15000]) | (raw_ts['Pressure_PSI'] == 0) |
            raw_ts['Temperature_C'].isin([-273.15, 1500]) | (raw_ts['Temperature_C'] == 0))
